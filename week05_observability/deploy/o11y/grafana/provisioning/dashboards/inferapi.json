{
  "title": "inferapi - Week 5 Observability",
  "uid": "inferapi-week05",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count[1m]))",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency: end-to-end vs model-only",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "end-to-end (HTTP)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inferapi_inference_duration_seconds_bucket[5m])))",
          "legendFormat": "model only (predict_proba)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
          "expr": "sum(rate(inferapi_errors_total[5m])) / sum(rate(http_server_request_duration_seconds_count[5m]))",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Mean confidence over time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
          "expr": "sum(rate(inferapi_prediction_confidence_sum[5m])) / sum(rate(inferapi_prediction_confidence_count[5m]))",
          "legendFormat": "mean confidence",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Confidence distribution (predictions/sec)",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "options": {
        "calculate": false,
        "yAxis": { "unit": "short" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
          "expr": "sum by (le) (rate(inferapi_prediction_confidence_bucket[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Confidence distribution (share of predictions)",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": {
        "calculate": false,
        "yAxis": { "unit": "short" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
          "expr": "sum by (le) (rate(inferapi_prediction_confidence_bucket[5m])) / on() group_left() sum(rate(inferapi_prediction_confidence_count[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Prediction mix by outcome",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
      "options": { "pieType": "donut" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
          "expr": "sum by (outcome) (inferapi_predictions_total)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Telemetry pipeline health (collector self-metrics)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points[5m]))",
          "legendFormat": "metric points/s accepted",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
          "expr": "sum(rate(otelcol_receiver_accepted_spans[5m]))",
          "legendFormat": "spans/s accepted",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mlops-prometheus" },
          "expr": "sum(rate(otelcol_receiver_refused_metric_points[5m]))",
          "legendFormat": "metric points/s refused",
          "refId": "C"
        }
      ]
    }
  ]
}
